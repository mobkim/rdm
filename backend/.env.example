# ---- Copy this file to `.env` and fill in the values ----

# Port the backend listens on. Open it directly (http://host:PORT/) to run
# without a reverse proxy, or forward a path to it from one (see README).
PORT=3010

# Optional built-in TLS. Set both to serve HTTPS/WSS directly (no reverse proxy
# needed) — required for browser clipboard sync over a LAN IP, since the
# Clipboard API only works in a secure context. Leave blank to serve plain HTTP
# (fine over http://localhost, which counts as secure). Generate a self-signed
# cert with, e.g.:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
#     -keyout tls.key -out tls.crt -subj "/CN=$(hostname -I | awk '{print $1}')"
TLS_CERT=
TLS_KEY=

# 32-byte key for AES-256-CBC. Encrypts the Guacamole connection tokens handed
# to the browser AND the custom-instance passwords stored in rdm.sqlite.
# MUST be exactly 32 characters. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
GUAC_CRYPT_KEY=change_me_to_a_random_32_byte_key

# Where the guacd daemon listens. Defaults suit the documented setup (a container
# publishing 4822 on this host); point them elsewhere if it runs on another
# machine. The backend probes this address before opening a session so an
# unreachable guacd is reported as such.
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

# The Start/Stop/Restart buttons in the Settings modal run `<CMD> <action> <NAME>`
# — i.e. `docker restart guacd` for the documented Docker setup. For a systemd
# unit use GUACD_SERVICE_CMD="sudo -n systemctl", which needs a passwordless
# sudoers rule for those three commands. Leave GUACD_SERVICE blank to remove the
# buttons entirely (the status readout stays).
GUACD_SERVICE=guacd
GUACD_SERVICE_CMD=docker

# guacd and the local RustDesk app are each auto-stopped after 12h with no
# connection attempt, and auto-started again the moment one comes in via
# /api/connect — so neither sits listening indefinitely between uses.
# RustDesk's side of this only does anything when the backend itself runs on
# the same Mac being connected to over the RustDesk protocol (it quits/opens
# the local app by process name via `pkill -x` / `open -a`) and is a no-op
# everywhere else, including non-macOS hosts. Leave RUSTDESK_APP_NAME blank to
# disable it even on a Mac.
RUSTDESK_APP_NAME=RustDesk

# Default RDP username for EC2 instances (Windows AMIs use "Administrator").
AWS_RDP_USERNAME=Administrator

# Fallback RDP password. Only used when the Windows password can't be fetched
# and decrypted automatically (see key.pem in the README). Leave blank if every
# instance's password is retrievable via the key pair.
RDP_PASSWORD=

# When "true", RDP is tunneled over AWS SSM (works for private instances that run
# the SSM agent and have an instance role). Requires the AWS CLI + the Session
# Manager plugin installed on this host. When unset/false, the backend connects
# directly to the instance's public/private IP on port 3389.
USE_SSM_TUNNEL=false

# AWS credentials & region. You may instead use ~/.aws/credentials or an instance
# role — the SDK's default credential chain is used. Cost Explorer (the billing
# figure) is always queried in us-east-1 regardless of this region.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Auth ----
# The app requires a login (set up on first visit). Sessions last this many
# days, sliding is not applied — see also the per-user "log out after
# inactivity" option in Settings, which is a separate, shorter-lived check.
SESSION_MAX_AGE_DAYS=30

# Comma-separated CIDRs treated as the trusted LAN, e.g.
# "192.168.1.0/24,127.0.0.1/32". Optional TOTP 2FA (enabled per-user from
# Settings) is skipped for logins whose source IP falls in one of these
# ranges, and enforced for everything else (e.g. arriving over a WireGuard/
# Tailscale tunnel). Leave blank to require 2FA from everywhere once it's
# enabled. Checked against the raw TCP source IP unless TRUST_PROXY (below)
# is set — see the README's "Behind a reverse proxy" section if you're
# running this behind one, since otherwise every login looks like it's
# coming from the proxy's own address.
TRUSTED_LAN_CIDRS=

# Only needed behind the optional reverse proxy (see README). Tells Express
# to derive the client's real IP (used by TRUSTED_LAN_CIDRS above) from
# X-Forwarded-For, but only when the connection itself comes from this
# trusted range — e.g. "loopback" for a proxy running on the same host.
# Leave blank otherwise; a wrong value here lets a remote client spoof
# X-Forwarded-For to impersonate a LAN source and skip 2FA.
TRUST_PROXY=

# Issuer label shown inside the authenticator app (Google Authenticator,
# Authy, ...) next to the account name.
TOTP_ISSUER=RDm
